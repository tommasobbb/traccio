# Traccio backend configuration.
# Copy to `.env` and adjust. All variables use the TRACCIO_ prefix.
# Do not put real secrets in this file — it is committed.

# Deployment environment: development | production
TRACCIO_ENVIRONMENT=development

# Logging
TRACCIO_LOG_LEVEL=INFO
TRACCIO_LOG_JSON=false

# PostgreSQL connection
TRACCIO_DATABASE_URL=postgresql+psycopg://localhost/traccio

# Fixed single-user id, stand-in for auth until M4. Every request is scoped to it.
TRACCIO_DEV_USER_ID=00000000-0000-0000-0000-000000000001

# Fernet key for encrypting stored bank credentials at rest (ADR 0003). Secret —
# never commit a real value here. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Left blank here: the app boots without it; it is required to store credentials.
TRACCIO_ENCRYPTION_KEY=

# Enable Banking (Open Banking provider). See docs/openbanking.md.
# Application id from the Control Panel; used as the JWT kid. Not a secret.
TRACCIO_ENABLE_BANKING_APPLICATION_ID=
# Path to the application's <application-id>.pem RSA private key. The key is a
# SECRET: keep it outside the repo, never commit it (*.pem is gitignored), never
# log it. Only this path is configuration.
TRACCIO_ENABLE_BANKING_PRIVATE_KEY_PATH=
# API base URL. Leave as the default production host unless testing.
TRACCIO_ENABLE_BANKING_BASE_URL=https://api.enablebanking.com
# Redirect the bank returns the user to after SCA. Must match the redirect
# registered in the Control Panel and the callback endpoint. https is mandatory.
TRACCIO_ENABLE_BANKING_REDIRECT_URL=https://localhost:8000/connections/callback
# How far back a connection's FIRST sync requests transactions. Deliberately
# generous: the post-auth window a bank serves full history for is short and
# does not come back (the ~1h window). ~2 years.
TRACCIO_INITIAL_HISTORY_DAYS=730
# How far before last_synced_at every LATER sync re-requests, to absorb
# retroactively dated entries. Free: dedup makes re-fetching harmless.
TRACCIO_SYNC_OVERLAP_DAYS=7

# Transfer detection (suggestions only — nothing is linked automatically).
# Max absolute difference between the two legs' magnitudes, in minor units
# (cents); absorbs fees on same-currency internal moves.
TRACCIO_TRANSFER_AMOUNT_TOLERANCE_CENTS=100
# Max whole-day gap between the two legs; settlement is not simultaneous.
TRACCIO_TRANSFER_WINDOW_DAYS=4

# How many days before a consent's expiry it is surfaced as "expiring soon"
# (domain/consent.py) rather than active.
TRACCIO_CONSENT_WARNING_WINDOW_DAYS=14

# How many days a pending transaction may go unseen by a sync before
# POST /transactions/prune-pending considers it abandoned.
TRACCIO_PENDING_TRANSACTION_TTL_DAYS=30

# Background sync scheduler (ADR 0010). Off by default: the app must boot
# with no .env without silently calling a real bank on startup.
TRACCIO_BACKGROUND_SYNC_ENABLED=false
# Minutes between the end of one scheduler tick and the start of the next.
TRACCIO_BACKGROUND_SYNC_INTERVAL_MINUTES=60
# Max sync runs (any outcome) per connection per rolling 24h. The hard
# per-consent background fetch budget most banks enforce (~4/day).
TRACCIO_BACKGROUND_SYNC_BUDGET_PER_DAY=4
# Minimum whole hours between two syncs of the same connection, so a recent
# sync (user-triggered or background) is not immediately repeated.
TRACCIO_SYNC_MIN_INTERVAL_HOURS=6
