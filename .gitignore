# --- Python / uv ---
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# --- Swift / Xcode ---
# .xcodeproj and Info.plist are generated by XcodeGen: never version them
*.xcodeproj/
client/App/Info.plist
*.xcworkspace/
!*.xcworkspace/contents.xcworkspacedata
.build/
.swiftpm/
DerivedData/
*.xcuserstate
xcuserdata/

# --- local dev database ---
# SQLite file used locally when no PostgreSQL is available; holds only
# synthetic seed data, but never version it regardless.
*.db

# --- files to import (ADR 0023) ---
# Real bank exports (Satispay .xlsx, CSV) used only to try the import
# feature: real financial data, never versioned, never a fixture (data-safety.md).
*.xlsx
*.csv

# --- secrets and environment ---
.env
.env.*
!.env.example
# --- deploy config (a deployer's own app name/region/redirect URL, ADR 0015) ---
backend/fly.toml
*.p8
*.p12
*.pem
*.mobileprovision
secrets/
# Self-signed TLS material for the local https callback (make run-tls).
.certs/

# --- Local agent config / personal working log ---
# tasks/ is a personal backlog+diary, .claude/ local agent config — never
# public, stripped from all of history's prior commits (Fase 5 cleanup).
CLAUDE.local.md
tasks/
.claude/

# --- design canvas ---
# Seeded, publishable payload built from the .dc.html sources by
# seed-canvas.mjs (~2 MB of editor code). Regenerate, don't version.
docs/design/canvas/traccio-app-design.html

# --- macOS / editor ---
.DS_Store
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json