# --- Python / uv ---
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# --- Swift / Xcode ---
# il .xcodeproj e l'Info.plist sono generati da XcodeGen: non vanno versionati
*.xcodeproj/
client/App/Info.plist
*.xcworkspace/
!*.xcworkspace/contents.xcworkspacedata
.build/
.swiftpm/
DerivedData/
*.xcuserstate
xcuserdata/

# --- database di sviluppo locale ---
# SQLite file usato in locale quando non c'è un PostgreSQL a disposizione;
# contiene solo dati sintetici del seed, ma non va comunque versionato.
*.db

# --- segreti e ambiente ---
.env
.env.*
!.env.example
*.p8
*.p12
*.mobileprovision
secrets/

# --- Local agent config ---
CLAUDE.local.md
.claude/settings.local.json

# --- macOS / editor ---
.DS_Store
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json